#HAPS System definition
board_system_create -haps -name IM_HAPS200
board_system_create -add HAPS200_6F_2 -name FB1 -stack_through none 		;# Primary module

############################
#Clock connections from first system to others and loopback
board_system_configure -connect {FB1.HC3_1 FB1.HC3_1}
############################

# Global clock - User design clock (22 MHz)
board_system_configure -clk_src PLL -frequency 22M -name GCLK_USER_CLK

# Clock assignments for 2 FPGAs (F0, F1)
board_system_configure -clock {FB1.F0.CLK1} GCLK_USER_CLK
board_system_configure -clock {FB1.F1.CLK1} GCLK_USER_CLK

# Commented for future use:
# board_system_configure -clk_src PLL -frequency 20M -name GCLK_AUX_CLK
# board_system_configure -clock {FB1.F0.CLK2} GCLK_AUX_CLK
# board_system_configure -clock {FB1.F1.CLK2} GCLK_AUX_CLK

# Inter-FPGA connections (F0 <-> F1 for control signals)
board_system_create -interconnect -manual CON_CABLE_25_HT3 -name FB1_F0_F1 -connector {FB1.F0_X4 FB1.F1_X29}

# Interconnect VCCO (1.2V) for HapsTrak 3
board_system_configure -voltage {FB1.F0_X4 FB1.F1_X29} 1.2
